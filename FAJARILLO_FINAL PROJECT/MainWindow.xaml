<Window x:Class="FAJARILLO_FINAL_PROJECT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Preflight Documentation System"
        Height="760"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F3F7FB">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#16324F"
                CornerRadius="24,0,0,24"
                Padding="36">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Digital Preflight Documentation"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"
                           TextWrapping="Wrap"/>
                <TextBlock Text="A desktop workflow for student submissions, instructor review, aircraft document monitoring, and real-time weight and balance verification."
                           Margin="0,18,0,0"
                           FontSize="16"
                           Foreground="#D8E6F2"
                           TextWrapping="Wrap"/>
                <Border Background="#23486D" CornerRadius="16" Padding="20" Margin="0,28,0,0">
                    <StackPanel>
                        <TextBlock Text="Seed Accounts"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="Admin: admin / admin123"
                                   Margin="0,12,0,4"
                                   Foreground="#EAF2F8"/>
                        <TextBlock Text="Instructor: instructor1 / instructor123"
                                   Margin="0,0,0,4"
                                   Foreground="#EAF2F8"/>
                        <TextBlock Text="Student: student1 / student123"
                                   Foreground="#EAF2F8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="White"
                CornerRadius="0,24,24,0"
                Padding="36">
            <Grid>
                <StackPanel x:Name="LoginPanel"
                            VerticalAlignment="Center"
                            Width="420">
                    <TextBlock Text="Sign In"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#16324F"/>
                    <TextBlock Text="Use your username or email together with your password."
                               Margin="0,10,0,26"
                               Foreground="#5A6E80"/>

                    <TextBlock Text="Username or Email" FontWeight="SemiBold"/>
                    <TextBox x:Name="LoginIdentityTextBox"
                             Height="36"
                             Margin="0,8,0,16"
                             Padding="10,6"/>

                    <TextBlock Text="Password" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="LoginPasswordBox"
                                 Height="36"
                                 Margin="0,8,0,12"
                                 Padding="10,6"/>

                    <TextBlock x:Name="LoginMessageTextBlock"
                               Foreground="#C0392B"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"/>

                    <Button Content="Login"
                            Height="42"
                            Background="#0E7490"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Login_Click"/>

                    <Button Content="Create Student Account"
                            Height="42"
                            Margin="0,12,0,0"
                            Background="#EAF2F8"
                            Foreground="#16324F"
                            BorderThickness="0"
                            Click="ShowSignUp_Click"/>
                </StackPanel>

                <ScrollViewer x:Name="SignUpPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="460" Margin="0,0,10,0">
                        <TextBlock Text="Student Sign Up"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#16324F"/>
                        <TextBlock Text="Create a student account with pilot document dates so the system can warn about expirations."
                                   Margin="0,10,0,24"
                                   Foreground="#5A6E80"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Full Name" FontWeight="SemiBold"/>
                        <TextBox x:Name="SignUpNameTextBox" Height="36" Margin="0,8,0,14" Padding="10,6"/>

                        <TextBlock Text="Username" FontWeight="SemiBold"/>
                        <TextBox x:Name="SignUpUsernameTextBox" Height="36" Margin="0,8,0,14" Padding="10,6"/>

                        <TextBlock Text="Email" FontWeight="SemiBold"/>
                        <TextBox x:Name="SignUpEmailTextBox" Height="36" Margin="0,8,0,14" Padding="10,6"/>

                        <TextBlock Text="Password" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="SignUpPasswordBox" Height="36" Margin="0,8,0,14" Padding="10,6"/>

                        <TextBlock Text="Birthdate" FontWeight="SemiBold"/>
                        <DatePicker x:Name="BirthdatePicker" Height="36" Margin="0,8,0,14"/>

                        <TextBlock Text="Student License Expiry" FontWeight="SemiBold"/>
                        <DatePicker x:Name="LicenseExpiryPicker" Height="36" Margin="0,8,0,14"/>

                        <TextBlock Text="Medical Certificate Expiry" FontWeight="SemiBold"/>
                        <DatePicker x:Name="MedicalExpiryPicker" Height="36" Margin="0,8,0,14"/>

                        <TextBlock x:Name="SignUpMessageTextBlock"
                                   Foreground="#C0392B"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap"/>

                        <Button Content="Create Account"
                                Height="42"
                                Background="#0E7490"
                                Foreground="White"
                                BorderThickness="0"
                                Click="SignUp_Click"/>

                        <Button Content="Back to Login"
                                Height="42"
                                Margin="0,12,0,0"
                                Background="#EAF2F8"
                                Foreground="#16324F"
                                BorderThickness="0"
                                Click="ShowLogin_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
