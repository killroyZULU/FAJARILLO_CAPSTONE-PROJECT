<Window x:Class="FAJARILLO_FINAL_PROJECT.WINDOWS.FlightDetailsInput"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FAJARILLO_FINAL_PROJECT.WINDOWS"
        mc:Ignorable="d"
        Title="FlightDetailsInput" Height="800" Width="700"
         KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_KeyDown">
    <Border Padding="20" CornerRadius="12" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Aircraft Type -->
            <TextBlock Text="Aircraft Type:" 
                       Grid.Row="0" Grid.Column="0" 
                       VerticalAlignment="Center" Margin="0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="AircraftTypeBox" 
                     Grid.Row="0" Grid.Column="1" 
                     Margin="5" Height="30"/>

            <!-- Registration -->
            <TextBlock Text="Registration:" 
                       Grid.Row="1" Grid.Column="0" 
                       VerticalAlignment="Center" Margin="0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="RegistrationBox" 
                     Grid.Row="1" Grid.Column="1" 
                     Margin="5" Height="30"/>

            <!-- Flight Date -->
            <TextBlock Text="Flight Date:" 
                       Grid.Row="2" Grid.Column="0" 
                       VerticalAlignment="Center" Margin="0,5" FontWeight="SemiBold"/>
            <DatePicker x:Name="FlightDatePicker" 
                        Grid.Row="2" Grid.Column="1" 
                        Margin="5" Height="30"/>

            <!-- Flight Time -->
            <TextBlock Text="Flight Time:" 
                       Grid.Row="3" Grid.Column="0" 
                       VerticalAlignment="Center" Margin="0,5" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="5">
                <TextBox x:Name="HoursBox" Width="50" Height="30" Margin="0,0,5,0"/>
                <TextBlock Text="h" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="MinutesBox" Width="50" Height="30" Margin="0,0,5,0"/>
                <TextBlock Text="m" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" 
                        HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="SaveButton" Content="Save" Width="100" Height="35" Margin="10"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" BorderBrush="#1E40AF" Click="Save_Click"/>
                <Button Content="Cancel" Width="100" Height="35" Margin="10"
                        Background="#E5E7EB" Foreground="Black" FontWeight="Bold" BorderBrush="#9CA3AF" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
