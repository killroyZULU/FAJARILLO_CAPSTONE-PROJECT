<Window x:Class="FAJARILLO_FINAL_PROJECT.WINDOWS.LoggedFlights"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FAJARILLO_FINAL_PROJECT.WINDOWS"
        mc:Ignorable="d"
        Title="LoggedFlights" Height="800" Width="700">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Controls -->
            <RowDefinition Height="*"/>
            <!-- List -->
            <RowDefinition Height="Auto"/>
            <!-- Total Time -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header with Back and Sorting -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <!-- Back Button -->
            <Button Content="⮌ Back" Click="Back_Click" 
                    Padding="10,5"
                    Margin="0,0,15,0"
                    Width="90"
                    Background="#E5E7EB"
                    BorderThickness="0"
                    DockPanel.Dock="Left"/>

            <!-- Sorting -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Sort by Date:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="SortComboBox" Width="160" SelectionChanged="SortComboBox_SelectionChanged"
                          Background="White" BorderBrush="#D1D5DB" Padding="5">
                    <ComboBoxItem Content="Earliest First"/>
                    <ComboBoxItem Content="Latest First"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- Flight List -->
        <Border Grid.Row="1" CornerRadius="10" BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Padding="5">
            <ListView x:Name="FlightListView" Margin="0,0,0,10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Aircraft Type" DisplayMemberBinding="{Binding AircraftType}" Width="150"/>
                        <GridViewColumn Header="Registration" DisplayMemberBinding="{Binding Registration}" Width="150"/>
                        <GridViewColumn Header="Flight Date" DisplayMemberBinding="{Binding FlightDate}" Width="150"/>
                        <GridViewColumn Header="Flight Time" DisplayMemberBinding="{Binding FlightTime}" Width="120"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Total Time -->
        <TextBlock x:Name="TotalTimeText" Grid.Row="2" HorizontalAlignment="Right" FontSize="16" 
                   FontWeight="Bold" Foreground="#374151" Margin="0,10,0,10"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Add Flight" Click="AddFlight_Click"
                    Width="100" Height="35" Margin="5"
                    Background="#3B82F6" Foreground="White"
                    BorderThickness="0"/>
            <Button Content="Edit Flight" Click="EditFlight_Click"
                    Width="100" Height="35" Margin="5"
                    Background="#10B981" Foreground="White"
                    BorderThickness="0"/>
            <Button Content="Delete Flight" Click="DeleteFlight_Click"
                    Width="100" Height="35" Margin="5"
                    Background="#EF4444" Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
